{
  // Solution file. Not built directly — `npm run build`/`npm run typecheck`
  // invoke tsconfig.app.json and tsconfig.node.json separately, because
  // vite.config.ts is allowed Node's globals and everything under src/ is
  // not; a single shared program cannot make that distinction, since an
  // ambient global declared in one file is visible to every file compiled
  // alongside it. This file exists so an editor opened at frontend/ still
  // finds one tsconfig.json and routes each open file to the right project.
  // See #222.
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
