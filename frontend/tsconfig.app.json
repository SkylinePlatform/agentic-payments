{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Empty on purpose: `vite/client`'s ambient declarations come from
    // src/test/vite-client.d.ts's `path` reference instead, which is what
    // lets typeRoots below be pinned without breaking them. See that file's
    // doc comment for why a `types` entry and a pinned typeRoots cannot
    // coexist here.
    "types": [],

    // Pinned to keep type resolution from walking out of the repository —
    // the default search climbs every ancestor node_modules/@types above
    // this package, and a stray @types/node reachable that way silently
    // makes `process` a global here, defeating what src/test/node-fs.d.ts
    // exists to guarantee. `./src/test/types` comes first: it holds an empty
    // stand-in named `node` that intercepts the one reference this pin alone
    // cannot stop — see src/test/types/node/index.d.ts for the mechanism and
    // why the pin has to be paired with it. #222.
    "typeRoots": ["./src/test/types", "./node_modules/@types"],

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Strict, and the four extra checks the default does not turn on. This is
    // a proof of concept about proving things, and a frontend that reads a
    // field nobody set is the kind of wrongness a screenshot hides.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
