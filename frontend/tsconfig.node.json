{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // vite.config.ts genuinely runs under Node, and this is the one
    // TypeScript program in this package allowed to know that: Node's
    // globals are granted here, deliberately, and nowhere else. `typeRoots`
    // is still pinned to this package's own node_modules/@types rather than
    // left at its default — not because vite.config.ts's own code reaches
    // for a Node global today (it does not; see the comment on `loadEnv`
    // below), but so that whichever @types/node answers a future
    // process.cwd() or path.resolve() here is always this repository's own
    // devDependency and never a stray one above it. #222.
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],

    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
