#!/bin/sh
#
# Refuse to push a branch containing an unsigned commit.
#
# main has required_signatures enabled, so GitHub already refuses these. What it
# does not do is say so usefully: the pull request reports a bare BLOCKED with
# every check green and no review outstanding, which is the same status it shows
# for a missing approval. Diagnosing it means knowing to run
# `git log --format='%G?'`, which nobody thinks to do while looking at five
# green checks.
#
# So this moves the failure to the push, where the branch is in front of you and
# the fix is one rebase away rather than one merge attempt and a wrong theory.
#
# It is a guardrail, not a gate. `git push --no-verify` skips it and GitHub is
# still the thing that actually enforces the rule.
#
# Installed by `make hooks`, which sets core.hooksPath. That setting is
# repository-local, so it covers git worktrees too — which is the case that
# produced the unsigned commit this exists for.

set -eu

remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '[:xdigit:]' '0')

fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
	# Deleting a remote branch pushes the zero sha. Nothing to check.
	if [ "$local_sha" = "$zero" ]; then
		continue
	fi

	if [ "$remote_sha" = "$zero" ]; then
		# A branch the remote has never seen: everything on it that is not
		# already published somewhere on this remote.
		range=$(git rev-list "$local_sha" --not --remotes="$remote")
	else
		range=$(git rev-list "$remote_sha..$local_sha")
	fi

	for commit in $range; do
		# %G? is the signature verdict. N is unsigned and B is a bad
		# signature; both are refused.
		#
		# E is deliberately allowed. It means the signature exists but was
		# made by a key this keyring does not hold, which is exactly what
		# GitHub's own squash-merge commits look like — refusing it would
		# fail every branch cut from main.
		verdict=$(git log --format='%G?' -1 "$commit")
		case "$verdict" in
		N | B)
			if [ "$fail" -eq 0 ]; then
				echo "pre-push: refusing to push unsigned commits." >&2
				echo >&2
			fi
			fail=1
			printf '  %s  %s  %s\n' \
				"$verdict" \
				"$(git log --format='%h' -1 "$commit")" \
				"$(git log --format='%s' -1 "$commit")" >&2
			;;
		esac
	done
done

if [ "$fail" -ne 0 ]; then
	cat >&2 <<'EOF'

main requires signed commits, so GitHub would refuse this too — but it would
refuse it as a bare BLOCKED status on the pull request, with every check green,
which reads like a missing review rather than a missing signature.

To sign what is already committed:

  git rebase --exec 'git commit --amend --no-edit -S' <base>

If signing itself is failing, fix that rather than passing --no-gpg-sign: an
unsigned commit makes the immediate problem disappear and hands the cost to
whoever tries to merge.

  git config --get user.signingkey
  echo test | gpg --batch --no-tty --sign -o /dev/null
EOF
	exit 1
fi

exit 0
