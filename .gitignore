# Go
bin/
*.test
*.out
vendor/

# Editor-local: go.mod sits in backend/, so an editor opened at the repository
# root has no module to anchor on and gopls falls back to a GOPATH view. A
# go.work listing both modules fixes that. It stays untracked because CI builds
# backend/ standalone on purpose — see the GOWORK note in the Makefile.
go.work
go.work.sum

# Node
node_modules/
dist/
.vite/
*.local

# Exported diagrams. `make diagrams` regenerates them; committing them would
# add a class of file that can silently go stale against the document it came
# from.
docs/diagrams/*.svg
docs/diagrams/*.md
!docs/diagrams/INDEX.md

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key
!testdata/**/*.pem

# Editors / OS
.idea/
.vscode/
.DS_Store

# Generated from contracts/ — see contracts/codegen.mk
backend/internal/core/generated/
frontend/src/protocol/generated/

# Scratch files from `make generate-verify`
.generate-verify.*

# Claude implementation plans. The spec is a repository artefact — it records
# decisions the code has to honour. A plan is scaffolding for producing the
# code and stops being true the moment the work lands, so it stays on disk and
# out of git.
docs/plans/

# Subagent-driven-development scratch: ledgers, task briefs, review packages.
.superpowers/
